{
  "info": {
    "_postman_id": "k10-academy-analytics-report-api-v1",
    "name": "K10 Football Academy - Analytics Report APIs",
    "description": "Comprehensive APIs for Academy Analytics Report Dashboard (Screenshots 1-6). Includes Top Metric Overview, Revenue Breakdown (Fees, Events, Store), Expenses Distribution Donut, Game Reports Analytics (Volume & Trends), Player Evaluations Analytics (Monthly Status & Radar Skill Scores), Transfers Analytics (Flow Trends & Statuses), Player CV Validation (Tiers, Distribution & Cumulative Growth), and Detailed Report PDF Exports with Year Filtering.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token_ACADEMY",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get Full Analytics Report Dashboard - Query Param (?year=2026)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/analytics-report?year=2026",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "analytics-report"],
          "query": [
            {
              "key": "year",
              "value": "2026",
              "description": "Filter by target year (e.g. 2026, 2025, 2024)"
            },
            {
              "key": "months",
              "value": "12",
              "description": "Number of months to analyze (defaults to 12 for full year Jan-Dec, or specify 6 for Jan-Jun)"
            }
          ]
        },
        "description": "Fetches the full consolidated analytics report dashboard filtered by year using query parameter ?year=YYYY. Returns top KPI cards (Revenue, Expenses, Players, Matches Won), availableYears for dropdowns, 12-month Revenue Breakdown, Expenses Distribution, Game Reports, Player Evaluations (with Radar Skills), Transfers (Flow & Statuses), and Player CV Validation (Tiers & Cumulative Trend)."
      },
      "response": []
    },
    {
      "name": "2. Get Full Analytics Report Dashboard - Path Param (/analytics-report/2026)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/analytics-report/2026",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "analytics-report", "2026"]
        },
        "description": "Alternative path parameter format: /api/v1/academies/analytics-report/:year"
      },
      "response": []
    },
    {
      "name": "2. Export Report - Full Comprehensive Analytics Summary (Year Filtered)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/analytics-report/export?reportType=FULL_ANALYTICS&year=2026",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "analytics-report", "export"],
          "query": [
            {
              "key": "reportType",
              "value": "FULL_ANALYTICS"
            },
            {
              "key": "year",
              "value": "2026",
              "description": "Filter export by year"
            }
          ]
        },
        "description": "Top-right '[EXPORT REPORT]' action returning complete consolidated management export data for the chosen year."
      },
      "response": []
    },
    {
      "name": "3. Export Detailed Report - Fees Summary Report (Year Filtered)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/analytics-report/export?reportType=FEES_SUMMARY&year=2026&period=JANUARY%202026",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "analytics-report", "export"],
          "query": [
            {
              "key": "reportType",
              "value": "FEES_SUMMARY"
            },
            {
              "key": "year",
              "value": "2026"
            },
            {
              "key": "period",
              "value": "JANUARY 2026"
            }
          ]
        },
        "description": "Detailed Report Item 1: 'FEES SUMMARY REPORT' with player-level payment records, dates, and amounts filtered by year."
      },
      "response": []
    },
    {
      "name": "4. Export Detailed Report - Match Expenses Report (Year Filtered)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/analytics-report/export?reportType=MATCH_EXPENSES&year=2026&period=Q1%202026",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "analytics-report", "export"],
          "query": [
            {
              "key": "reportType",
              "value": "MATCH_EXPENSES"
            },
            {
              "key": "year",
              "value": "2026"
            },
            {
              "key": "period",
              "value": "Q1 2026"
            }
          ]
        },
        "description": "Detailed Report Item 2: 'MATCH EXPENSES REPORT' with fixtures, transport, ground, and referee cost breakdown filtered by year."
      },
      "response": []
    },
    {
      "name": "5. Export Detailed Report - Event Costs Summary (Year Filtered)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/analytics-report/export?reportType=EVENT_COSTS&year=2026&period=ALL%20TIME",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "analytics-report", "export"],
          "query": [
            {
              "key": "reportType",
              "value": "EVENT_COSTS"
            },
            {
              "key": "year",
              "value": "2026"
            },
            {
              "key": "period",
              "value": "ALL TIME"
            }
          ]
        },
        "description": "Detailed Report Item 3: 'EVENT COSTS SUMMARY' with event registrations, fees, and attendee totals filtered by year."
      },
      "response": []
    }
  ]
}
