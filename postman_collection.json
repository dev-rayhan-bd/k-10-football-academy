{
  "info": {
    "_postman_id": "k10-football-collection-v1",
    "name": "K10 Football Academy Platform API Collection",
    "description": "Complete Postman collection for K10 Football Platform with Automated Token Extraction & Role-based Environment Setup",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth & Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.player@k10football.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"PLAYER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            }
          }
        },
        {
          "name": "Login User (Auto Token Saving)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
                  "    var token = jsonData.data.accessToken;",
                  "    var role = jsonData.data.user ? jsonData.data.user.role : 'DEFAULT';",
                  "    ",
                  "    pm.environment.set('accessToken', token);",
                  "    pm.environment.set('refreshToken', jsonData.data.refreshToken);",
                  "    pm.environment.set('token_' + role, token);",
                  "    ",
                  "    console.log('✅ Token Auto-saved! Active Role: ' + role);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.player@k10football.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.player@k10football.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["users", "verify-otp"]
            }
          }
        },
