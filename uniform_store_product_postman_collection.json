{
  "info": {
    "_postman_id": "k10-uniform-store-products-api-v1",
    "name": "K10 Football Academy - Uniform Store Products API",
    "description": "Complete APIs for Add New Product (Screenshots 1-5 modal) in the Uniform Store. Features: Dynamic Category addition & filtering, Price Range filtering (minPrice & maxPrice), Multi-field Search, Sorting (price, newest, name, popularity), Stock Status filtering (IN_STOCK / OUT_OF_STOCK), In-stock vs Out-of-stock count stats in response, and Product Details lookup by Slug.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token_ACADEMY",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Add New Product (Uniform Store Modal - Screenshots 1-5)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"Official Home Jersey 2024\",\n  \"category\": \"Jerseys\",\n  \"sku\": \"JER-HOME-2024\",\n  \"regularPrice\": 89.99,\n  \"salePrice\": 69.99,\n  \"productDescription\": \"Official high-performance home match jersey engineered with breathable moisture-wicking fabric, athletic fit, and club woven silicone badge.\",\n  \"availableSizes\": [\"XS\", \"S\", \"M\", \"L\", \"XL\", \"XXL\"],\n  \"availableColors\": [\"BLACK\", \"WHITE\", \"RED\"],\n  \"stockQuantity\": 45,\n  \"minStockLevel\": 5,\n  \"maxOrderQuantity\": 10,\n  \"productImage\": \"https://images.unsplash.com/photo-1577212017184-80cc0da11082?w=800\",\n  \"isActive\": true,\n  \"isFeatured\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/shop/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "shop", "products"]
        },
        "description": "Submits the Add New Product modal form. Automatically computes unique slug (e.g., 'official-home-jersey-2024'), sets stockStatus ('IN_STOCK' or 'OUT_OF_STOCK'), auto-generates SKU if left blank, and saves whatever category string is entered."
      },
      "response": []
    },
    {
      "name": "2. Get All Products - With Search, Category, Price Range, Stock Filter & Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/shop/products?search=Jersey&category=Jerseys&minPrice=50&maxPrice=100&stockStatus=IN_STOCK&sortBy=price&sortOrder=asc&page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "shop", "products"],
          "query": [
            {
              "key": "search",
              "value": "Jersey",
              "description": "Searches across productName, description, SKU, and category"
            },
            {
              "key": "category",
              "value": "Jerseys",
              "description": "Filter by dynamic category string"
            },
            {
              "key": "minPrice",
              "value": "50",
              "description": "Minimum price"
            },
            {
              "key": "maxPrice",
              "value": "100",
              "description": "Maximum price"
            },
            {
              "key": "stockStatus",
              "value": "IN_STOCK",
              "description": "Filter by 'IN_STOCK' or 'OUT_OF_STOCK'"
            },
            {
              "key": "sortBy",
              "value": "price",
              "description": "Sort by: 'price', 'createdAt', 'name', 'stock'"
            },
            {
              "key": "sortOrder",
              "value": "asc",
              "description": "'asc' or 'desc'"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Fetches products list with multi-criteria filtering. Response includes 'stats' containing totalProducts, inStockCount, outOfStockCount, and dynamic categories list."
      },
      "response": []
    },
    {
      "name": "3. Get Product Details by Slug",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/shop/products/official-home-jersey-2024",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "shop", "products", "official-home-jersey-2024"]
        },
        "description": "Fetches product details using the unique slug generated from product name. (Also accepts product ObjectId as fallback)."
      },
      "response": []
    },
    {
      "name": "4. Get All Distinct Categories (For Dynamic Filter Dropdown)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/shop/products/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "shop", "products", "categories"]
        },
        "description": "Returns all unique category strings currently registered in the database for rendering dropdowns."
      },
      "response": []
    },
    {
      "name": "5. Update Product (By Slug or ID)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"regularPrice\": 95.00,\n  \"salePrice\": 79.99,\n  \"stockQuantity\": 50,\n  \"availableSizes\": [\"S\", \"M\", \"L\", \"XL\"],\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/shop/products/official-home-jersey-2024",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "shop", "products", "official-home-jersey-2024"]
        },
        "description": "Updates product details, price, inventory, or sizes by slug or ID."
      },
      "response": []
    },
    {
      "name": "6. Delete Product (By Slug or ID)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/shop/products/official-home-jersey-2024",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "shop", "products", "official-home-jersey-2024"]
        },
        "description": "Deletes a product by slug or ObjectId."
      },
      "response": []
    }
  ]
}
