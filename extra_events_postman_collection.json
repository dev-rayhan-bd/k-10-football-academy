{
  "info": {
    "_postman_id": "k10-extra-events-api-collection",
    "name": "K10 Academy - Extra Events Management APIs",
    "description": "Complete enterprise API endpoints for:\n1. Extra Events Page (List special events & activities, status badges [OPEN, CLOSING SOON, CLOSED], capacity ratio [32/40], fee formatted [£250], search and filters by eventType and date)\n2. Create Extra Event Modal (form-data with 'data' JSON string and 'bannerImage' image file upload)\n3. Update Extra Event (form-data with 'data' JSON string and 'bannerImage' image file upload)\n4. Metadata / Dropdown API (reusing existing academy teams, event types, age groups, attendees)\n5. Event Registration API (Increment attendees, track capacity, auto-close)\n\nAuthenticated using Bearer Token with {{token_ACADEMY}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_ACADEMY}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Dropdowns & Form Metadata (Reused Teams)",
      "item": [
        {
          "name": "1. Get Extra Events Meta (All Dropdown Options & Reused Teams)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events/meta",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events", "meta"]
            },
            "description": "Returns event types, groups, age groups, target attendees, status options, date filters, and our academy teams reused directly from the database without duplicate endpoints."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Extra Events Management",
      "item": [
        {
          "name": "1. Get Extra Events (List & Filter Cards)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events?page=1&limit=10&searchTerm=&eventType=&status=&date=&group=&ageGroup=",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (default: 10)"
                },
                {
                  "key": "searchTerm",
                  "value": "",
                  "description": "Search by event name, venue, address, or event type"
                },
                {
                  "key": "eventType",
                  "value": "",
                  "description": "Filter by Event Type ('All Events' dropdown: Summer Training Camp, Tournament Registration, Skills Workshop, etc.)"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filter by status: OPEN, CLOSING SOON, CLOSED"
                },
                {
                  "key": "date",
                  "value": "",
                  "description": "Filter by date ('Date' dropdown): today, this_week, this_month, upcoming, past, or YYYY-MM-DD"
                },
                {
                  "key": "group",
                  "value": "",
                  "description": "Filter by group: Academy Members, Grassroots Teams, etc."
                },
                {
                  "key": "ageGroup",
                  "value": "",
                  "description": "Filter by age group: U-9, U-11, U-13, U-15, Senior, etc."
                }
              ]
            },
            "description": "Returns all cards matching UI Screenshot 1 with badges (OPEN, CLOSING SOON, CLOSED), date formatting (e.g. 15-20 FEBRUARY 2026), fee (£ 250), and attendees ratio (32/40)."
          },
          "response": []
        },
        {
          "name": "2. Create Extra Event (Create Modal Form - form-data)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"eventName\": \"Summer Training Camp\",\n  \"eventType\": \"Summer Training Camp\",\n  \"group\": \"Academy Members\",\n  \"ageGroup\": \"U-15\",\n  \"targetAttendees\": \"Open to All\",\n  \"eventDate\": \"2026-02-15\",\n  \"eventEndDate\": \"2026-02-20\",\n  \"formattedDateRange\": \"15-20 FEBRUARY 2026\",\n  \"startTime\": \"09:00 AM\",\n  \"endTime\": \"04:00 PM\",\n  \"registrationDeadline\": \"2026-02-10\",\n  \"venueName\": \"St. George's National Football Centre\",\n  \"venueAddress\": \"Newborough Road, Needwood, Burton upon Trent, DE13 9PD\",\n  \"registrationFee\": 250,\n  \"currency\": \"£\",\n  \"maxCapacity\": 40,\n  \"description\": \"Comprehensive intensive football training camp covering tactical drills, technical skills, fitness assessments, and competitive matches.\",\n  \"requirements\": \"Football boots, shin pads, training kit, water bottle, and completed medical consent form.\",\n  \"contactPerson\": \"Coach Marcus Vance\",\n  \"contactPhone\": \"+44 7123 456789\",\n  \"contactEmail\": \"events@k10football.com\",\n  \"status\": \"OPEN\"\n}",
                  "type": "text"
                },
                {
                  "key": "bannerImage",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events"]
            },
            "description": "Creates a new extra event using form-data. Key 'data' holds the JSON object string and key 'bannerImage' uploads the event banner file directly."
          },
          "response": []
        },
        {
          "name": "3. Get Extra Event Details by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events", "{{eventId}}"]
            },
            "description": "Fetches complete event details including description, requirements, contact info, banner, and registered participants."
          },
          "response": []
        },
        {
          "name": "4. Update Extra Event (form-data)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"registrationFee\": 275,\n  \"maxCapacity\": 50,\n  \"status\": \"CLOSING SOON\",\n  \"requirements\": \"Updated requirements: Molded boots only for 4G pitch.\"\n}",
                  "type": "text"
                },
                {
                  "key": "bannerImage",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events", "{{eventId}}"]
            },
            "description": "Updates any event field, fee, capacity, or status using form-data. Optional 'bannerImage' file updates the banner image."
          },
          "response": []
        },
        {
          "name": "5. Register Participant for Event",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alexandre Pato\",\n  \"email\": \"alexandre.pato@example.com\",\n  \"phone\": \"+44 7987 654321\",\n  \"teamName\": \"Santos FC U-15\",\n  \"paidAmount\": 250,\n  \"paymentStatus\": \"PAID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events/{{eventId}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events", "{{eventId}}", "register"]
            },
            "description": "Registers a participant or team for the event. Increments currentAttendees and automatically updates status to CLOSED when maxCapacity is reached."
          },
          "response": []
        },
        {
          "name": "6. Delete Extra Event",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ACADEMY}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/academies/extra-events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["academies", "extra-events", "{{eventId}}"]
            },
            "description": "Permanently deletes an event record."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5005/api/v1",
      "type": "string"
    },
    {
      "key": "token_ACADEMY",
      "value": "YOUR_ACADEMY_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "EVENT_ID_HERE",
      "type": "string"
    }
  ]
}
