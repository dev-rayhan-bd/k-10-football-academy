{
  "info": {
    "_postman_id": "k10-academy-player-evaluation-api-v1",
    "name": "K10 Football Academy - Player Evaluation Management & Details APIs",
    "description": "Comprehensive APIs for Player Evaluation Management Dashboard (Screenshot 1) and Player Evaluation Details Report Overlay (Screenshot 2). Provides metric cards, evaluations list, most improved widget, top performers, full skills breakdown (Technical, Mental, Physical), and PDF download data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token_ACADEMY",
      "value": "",
      "type": "string"
    },
    {
      "key": "evaluationId",
      "value": "6ada2641205107b1c92986b8",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Player Evaluation Dashboard (Screenshot 1)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/player-evaluations/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "player-evaluations", "dashboard"]
        },
        "description": "Fetches the 4 top metric cards (Avg. Overall Rating, Improving Players, Evaluated this Month, Total Evaluations), Most Improved widget, Top Performers widget, and evaluations grid matching Screenshot 1."
      },
      "response": []
    },
    {
      "name": "2. Player Evaluations List with Filter & Search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/player-evaluations?searchTerm=Marcus&ageGroup=U-15&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "player-evaluations"],
          "query": [
            {
              "key": "searchTerm",
              "value": "Marcus",
              "description": "Search by player name, coach name, position, or current club"
            },
            {
              "key": "ageGroup",
              "value": "U-15",
              "description": "Filter by age group (e.g. U-15, U-16, U-17, U-19, U-24)"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Filter evaluations by search term, age group, or paginate."
      },
      "response": []
    },
    {
      "name": "3. Player Evaluation Details View (Screenshot 2 Overlay)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/player-evaluations/{{evaluationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "player-evaluations", "{{evaluationId}}"]
        },
        "description": "Fetches full Player Evaluation Report details matching Screenshot 2 (Development Report Sheet Overlay with Technical skills breakdown [Dribbling, Ball Mastery, etc.], Mental skills breakdown [Game Awareness, Decision Making, etc.], Physical skills breakdown, coach feedback, overall rating, and player metadata)."
      },
      "response": []
    },
    {
      "name": "4. Download Player Evaluation PDF Data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/academies/player-evaluations/{{evaluationId}}/pdf",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "academies", "player-evaluations", "{{evaluationId}}", "pdf"]
        },
        "description": "Fetches official printable / PDF data for the 'DOWNLOAD PDF' button in the overlay (Screenshot 2)."
      },
      "response": []
    },
    {
      "name": "5. Coach Route Details View Alias (ACADEMY Allowed)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_ACADEMY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/coaches/player-evaluations/{{evaluationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "coaches", "player-evaluations", "{{evaluationId}}"]
        },
        "description": "Existing Coach/Player evaluation details route updated with ACADEMY authorization so academy can reuse this endpoint if preferred."
      },
      "response": []
    }
  ]
}
