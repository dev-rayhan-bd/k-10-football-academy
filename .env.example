# Application Configuration
NODE_ENV=development
PORT=5005

# Database Configuration
DATABASE_URL=mongodb://127.0.0.1:27017/k10_football

# Redis Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# JWT Authentication Secrets & Expirations (256-bit Cryptographic Hex)
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=

# SMTP Configuration (For Email/OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@k10football.com

# Security & Encryption
BCRYPT_SALT_ROUNDS=

# Logging
LOG_LEVEL=

# Default Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Storage (When configured, auto-switches from Cloudinary to S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name
