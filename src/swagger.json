{
  "openapi": "3.0.0",
  "info": {
    "title": "K10 Football Academy Platform API",
    "version": "1.0.0",
    "description": "Complete API documentation for the K10 Football Academy Platform Backend"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server (Auto-detect Domain/Host)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "API Root",
        "description": "Returns a welcome message and API base path",
        "responses": {
          "200": {
            "description": "Welcome message"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Returns the health status of the API",
        "responses": {
          "200": {
            "description": "Health status with uptime"
          }
        }
      }
    },
    "/api/v1/users/register": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "name",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "SUPER_ADMIN",
                      "ADMIN",
                      "AGENT",
                      "ACADEMY",
                      "CLUB",
                      "COACH",
                      "PLAYER",
                      "GUARDIAN",
                      "SCOUT"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          }
        }
      }
    },
    "/api/v1/users/login": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "User login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful with JWT tokens"
          }
        }
      }
    },
    "/api/v1/users/verify-otp": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "Verify email OTP code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "otp"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified successfully"
          }
        }
      }
    },
    "/api/v1/users/resend-otp": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "Resend OTP code to email (60s cooldown)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New OTP code sent to email"
          }
        }
      }
    },
    "/api/v1/users/refresh-token": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "Refresh Access Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token issued"
          }
        }
      }
    },
    "/api/v1/users/logout": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "Logout user (Redis token revocation)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out successfully"
          }
        }
      }
    },
    "/api/v1/users/change-password": {
      "post": {
        "tags": [
          "Users & Authentication"
        ],
        "summary": "Change user password",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "oldPassword",
                  "newPassword"
                ],
                "properties": {
                  "oldPassword": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed successfully"
          }
        }
      }
    },
